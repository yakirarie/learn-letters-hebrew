  "private": true,
  "description": "An interactive educational web app for children to learn Hebrew letters, numbers, and basic math in a fun and engaging way.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
